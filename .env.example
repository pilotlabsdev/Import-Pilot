# =============================================================================
# Variables de entorno de la app. Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
# =============================================================================

# Credenciales de la app en Shopify Partners
# (https://partners.shopify.com → Apps → tu app)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Alcances de OAuth (deben coincidir con [access_scopes] de shopify.app.toml)
SCOPES=write_products,read_products,read_inventory,write_inventory,read_locations,read_content

# URL pública de la app (túnel HTTPS de `shopify app dev`). LOS WEBHOOKS
# REQUIEREN HTTPS — nunca uses localhost en producción.
SHOPIFY_APP_URL=https://REPLACE_WITH_TUNNEL_URL

# -----------------------------------------------------------------------------
# Opcionales
# -----------------------------------------------------------------------------

# Directorio de trabajo de los jobs bulk (JSONL de create/update + manifest).
# Debe persistir entre reinicios para poder reanudar jobs a medias.
# Default: directorio temporal del sistema (`os.tmpdir()/mediamax-bulk`).
# MEDIMAX_BULK_DIR=C:\mediamax-bulk

# Días que se conservan los BulkJob terminados (done/failed) antes de limpiarlos
# de la BD y del disco (op). Default: 7.
# MEDIMAX_JOB_RETENTION_DAYS=7
